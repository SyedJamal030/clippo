---
import { whyChooseUs } from '@/data/why-choose-clippo';

interface Props {
  h1: string;
  h2: string;
}

const { h1, h2 } = Astro.props;
---

<section class="max-w-5xl mx-auto px-4 py-12 md:py-16 flex flex-col items-center">
  <!-- Hero Header Content -->
  <div class="text-center max-w-3xl mb-10">
    <h1
      class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-base-content mb-4"
    >
      {h1}
    </h1>
    <p class="text-base sm:text-lg text-base-content/70">
      {h2}
    </p>
  </div>

  <div
    class="w-full max-w-3xl mb-8 min-h-[90px] bg-base-200/50 border border-base-300 rounded-box flex items-center justify-center text-xs text-base-content/40"
  >
    <span>Advertisement Banner (728x90)</span>
  </div>

  <!-- Main Tool Component Slot -->
  <div class="w-full mb-20">
    <slot />
  </div>

  <div
    class="w-full max-w-3xl mb-8 min-h-[90px] bg-base-200/50 border border-base-300 rounded-box flex items-center justify-center text-xs text-base-content/40"
  >
    <span>Advertisement Banner (728x90)</span>
  </div>

  <!-- Feature Grid Section (Moved to Bottom) -->
  <div class="w-full flex flex-col items-center">
    <div class="flex flex-wrap w-full mb-12 flex-col items-center text-center">
      <h2 class="sm:text-3xl text-2xl font-bold title-font mb-3 text-base-content">
        Why Creators Choose Clippo
      </h2>
      <p class="lg:w-1/2 w-full leading-relaxed text-base-content/70 text-sm">
        Everything you need to cut, split, and repurpose long-form recordings directly inside your
        browser with absolute privacy.
      </p>
    </div>

    <!-- Feature Pointers Grid -->
    <div class="flex flex-wrap -m-4 w-full">
      <!-- Feature 1: Privacy -->
      {
        whyChooseUs.map((why) => (
          <div class="xl:w-1/3 md:w-1/2 p-4 w-full">
            <div class="card w-full bg-white dark:bg-neutral border border-base-300 card-md shadow-sm">
              <div class="card-body">
                <div class="w-10 h-10 inline-flex items-center justify-center rounded-full bg-primary/10 text-primary mb-4">
                  <why.Icon className="size-4" />
                </div>
                <h2 class="card-title">{why.title}</h2>
                <p>{why.description}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
