---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Fast Online Video Trimmer | Free & Secure",
  description = "Clippo is the fast and easy way to trim videos for Social Media. Get your clips ready to share in seconds.",
  image = "/og-image.png",
} = Astro.props;

const siteUrl = Astro.site ?? 'http://localhost:4321';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const currentURL = Astro.url.href;

// Convert relative image path to absolute URL required by WhatsApp/OpenGraph
const imageURL = new URL(image, Astro.url.origin).href;
---

<meta charset="UTF-8" />
<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0, viewport-fit=cover"
/>
<link rel="canonical" href={canonicalURL} />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />

<!-- Favicons & App Icons -->
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="Clippo" />

<!-- Theme Color for Mobile Browser Address Bar (Matches your Primary/Base Colors) -->
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ff865b" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#22262d" />

<link rel="manifest" href="/site.webmanifest" />

<!-- Open Graph / WhatsApp -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Clippo" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:secure_url" content={imageURL} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:url" content={currentURL} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<title>{title} | Clippo</title>

<!-- Core External Fonts & Icons -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />