---
import ToolLayout from '@/components/seo/ToolLayout.astro';
import Layout from '../components/seo/Layout.astro';
import VideoTrimmer from '../components/VideoTrimmer';

const title = 'Instagram Story Splitter - Cut Videos for IG Reels & Stories | Clippo';
const description =
  'Split long videos into equal parts for Instagram Stories and Reels. Fast, private, client-side video cutting with no app installation needed.';
---

<Layout title={title} description={description}>
  <ToolLayout
    h1="Instagram Story & Reel Video Splitter"
    h2="Chop long videos into 15, 30, or 60-second clips for seamless Instagram Stories and Reels."
  >
    <VideoTrimmer
      mode="split"
      client:only="react"
      segmentDuration={60}
      helperText="Drop your video here to split it into Instagram-optimized time segments. Ready to download and post immediately."
    />
  </ToolLayout>
</Layout>
