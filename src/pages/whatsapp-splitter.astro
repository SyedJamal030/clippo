---
import ToolLayout from '@/components/seo/ToolLayout.astro';
import Layout from '../components/seo/Layout.astro';
import VideoTrimmer from '../components/VideoTrimmer';

const title = 'WhatsApp Video Splitter - Split Long Videos for Status Free | Clippo';
const description =
  'Easily split long videos into 30-second or 60-second clips for WhatsApp Status. Free browser-based tool with no downloads or quality loss.';
---

<Layout title={title} description={description}>
  <ToolLayout
    h1="WhatsApp Video Splitter - Cut Long Videos into 30s & 60s Parts"
    h2="Automatically split long videos into perfect segments for WhatsApp Status without losing quality."
  >
    <VideoTrimmer
      mode="split"
      client:only="react"
      segmentDuration={30}
      helperText="Upload your video to automatically slice it into WhatsApp-ready status segments. Download individual parts instantly."
    />
  </ToolLayout>
</Layout>

